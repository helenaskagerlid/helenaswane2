---
import BgImage from "../assets/pinkBgHelena.png";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata | string;
  position?: string;
  opacity?: number;
  height?: string;
}

const {
  src = BgImage,
  position = "center 80%",
  opacity = 1,
  height = "180px",
} = Astro.props;
---

<section class="section-divider">
  {
    typeof src === "string" ? (
      <img class="divider-img" src={src} alt="" loading="lazy" />
    ) : (
      <Image
        class="divider-img"
        src={src}
        alt=""
        width="937"
        height="521"
        loading="lazy"
        format="webp"
      />
    )
  }
</section>

<style define:vars={{ position, opacity, height }}>
  .section-divider {
    margin-block: 80px;
    position: relative;
    height: var(--height);
    width: 100%;
    overflow: hidden;
  }

  .divider-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    object-position: var(--position);
    opacity: var(--opacity);
  }

  .section-divider::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #faf6f1 0%,
      rgba(250, 246, 241, 0) 35%
    );
    z-index: 2;
  }

  .section-divider::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #faf6f1 0%, rgba(250, 246, 241, 0) 30%);
    z-index: 3;
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionDivider from "../components/SectionDivider.astro";
import SignUpSection from "../components/SignUpSection.astro";
import { getEntry } from "astro:content";

// Texterna och bilderna redigeras i CMS:et (src/content/pages/kontakt.yml)
const page = await getEntry("contactPage", "kontakt");
if (!page) throw new Error("src/content/pages/kontakt.yml saknas");
const { intro, divider, innerPower } = page.data;

// Tom rad i CMS:et = nytt stycke
const paragraphs = (text: string) =>
  text
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);
---

<BaseLayout title="Kontakt">
  <section class="contact-section">
    <div class="contact-intro" id="heading">
      <h2 class="contact-heading">{intro.heading}</h2>
      {paragraphs(intro.text).map((p) => <p>{p}</p>)}
    </div>
    <form
      action="https://formsubmit.co/helenaskagerlid@gmail.com"
      method="POST"
      id="contact-form"
    >
      <input type="hidden" name="_captcha" value="false" />
      <input
        type="text"
        name="name"
        placeholder="Ditt namn"
        aria-label="Ditt namn"
        required
      />
      <input
        type="email"
        name="email"
        placeholder="Din e-post"
        aria-label="Din e-post"
        required
      />
      <textarea
        name="message"
        placeholder="Ditt meddelande"
        aria-label="Ditt meddelande"
        required></textarea>
      <button aria-label="Send message" type="submit">Skicka</button>
    </form>

    <p id="thankyou" style="display:none; margin-top:1em; color:#d82094;">
      Tack för ditt meddelande, jag återkommer så snart jag kan!
    </p>
  </section>

  <SectionDivider
    src={divider.image}
    position="center 35%"
    opacity={0.8}
    height="150px"
  />

  <section class="inner-power-section">
    <h2 class="contact-heading">{innerPower.heading}</h2>
    {paragraphs(innerPower.text).map((p) => <p>{p}</p>)}
    {innerPower.closing && <p class="cursive-text">{innerPower.closing}</p>}
    <a
      class="pill-button"
      href={innerPower.buttonLink}
      target="_blank"
      rel="noopener noreferrer"
    >
      {innerPower.buttonText}
    </a>
  </section>

  <SignUpSection background="contact" />

  <script type="module">
    const form = document.getElementById("contact-form");
    const heading = document.getElementById("heading");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const data = new URLSearchParams(new FormData(form));

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
          },
          body: data.toString(),
        });

        if (response.ok) {
          form.style.display = "none";
          heading.style.display = "none";
          document.getElementById("thankyou").style.display = "block";
        } else {
          alert("Något gick fel, försök igen!");
        }
      } catch (err) {
        alert("Något gick fel, försök igen!");
      }
    });
  </script>

  <style>
    .contact-section,
    .inner-power-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      padding-inline: 1.5rem;
    }

    .contact-section {
      padding-top: 80px;
    }

    .inner-power-section {
      max-width: 700px;
      margin-bottom: 80px;
      align-items: flex-start;
    }

    .contact-intro {
      width: 100%;
      max-width: 650px;
      margin-bottom: 30px;
    }

    .contact-heading {
      align-self: center;
      font-size: clamp(1.4rem, 0.2rem + 2vw, 2.5rem);
      font-weight: 500;
      text-transform: uppercase;
      color: #cfa734;
      text-align: center;
      margin: 0 0 30px 0;
    }

    .contact-intro p,
    .inner-power-section p {
      margin: 0 0 1em 0;
      line-height: 1.5;
    }

    .cursive-text {
      font-style: italic;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 100%;
      max-width: 650px;
      color: #5a5656;
      border: none;
    }

    input {
      height: 50px;
      background-color: white;
      color: #5a5656;
      border: none;
      padding: 16px;
    }

    textarea {
      height: 150px;
      background-color: white;
      border: none;
      padding: 16px;
      border-radius: 1%;
      color: #5a5656;
    }

    button,
    .pill-button {
      display: block;
      padding: 20px;
      border-radius: 9999px;
      border: none;
      cursor: pointer;
      background-color: #ff3b9c;
      color: white;
      text-transform: uppercase;
    }

    button {
      width: 150px;
      margin-left: auto;
    }

    .pill-button {
      margin-top: 1em;
      padding-inline: 30px;
      text-decoration: none;
      text-align: center;
    }
  </style>
</BaseLayout>

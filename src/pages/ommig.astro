---
import RoundGlowingBorder from "../animations/RoundGlowingBorder.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { paragraphs } from "../utils/paragraphs";

// Redigeras i CMS:et (src/content/pages/ommig.yml)
const page = await getEntry("aboutPage", "ommig");
if (!page) throw new Error("src/content/pages/ommig.yml saknas");
const { heading, text, image, imageAlt } = page.data;
---

<BaseLayout title="Om mig">
  <section class="about-helena-section section-inner">
    <div class="about-helena-content-wrapper">
      <h2 class="about-helena-heading">{heading}</h2>

      {paragraphs(text).map((p) => <p>{p}</p>)}
    </div>

    <div class="image-wrapper">
      <svg
        viewBox="0 0 200 200"
        xmlns="http://www.w3.org/2000/svg"
        class="svg-blob"
      >
        <defs>
          <linearGradient id="blobGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#e35b7d">
              <animate
                attributeName="stop-color"
                values="
      #e35b7d;
      #ef6c8f;
      #f492b8;
      #f7a3c6;
      #fcd1e3;
      #cc4668;
      #e35b7d;
      #ef6c8f;
      #f492b8;
      #f7a3c6;
      #e35b7d
    "
                dur="35s"
                repeatCount="indefinite"></animate>
            </stop>

            <stop offset="100%" stop-color="#f26fa0">
              <animate
                attributeName="stop-color"
                values="
      #f7a3c6;
      #fcd1e3;
      #e35b7d;
      #cc4668;
      #ef6c8f;
      #f492b8;
      #f7a3c6;
      #cc4668;
      #f26fa0
      #f7a3c6;
    "
                dur="35s"
                repeatCount="indefinite"></animate>
            </stop>
          </linearGradient>
        </defs>

        <path
          fill="url(#blobGradient)"
          d="M45.7,-73.1C57.8,-63.5,65,-48.2,70.8,-33C76.7,-17.9,81.2,-2.8,81,12.9C80.7,28.6,75.7,44.9,65.6,57.3C55.6,69.7,40.5,78.2,24.2,83.5C7.9,88.8,-9.7,90.9,-24.6,85.7C-39.6,80.5,-51.8,68,-63,54.8C-74.2,41.6,-84.3,27.6,-87.6,11.9C-90.8,-3.7,-87.2,-20.9,-78.8,-34.6C-70.4,-48.2,-57.1,-58.2,-43.2,-67C-29.2,-75.7,-14.6,-83.1,1.1,-84.9C16.9,-86.6,33.7,-82.7,45.7,-73.1Z"
          transform="translate(100 100)"></path>
      </svg>
      <Image
        class="about-helena-img"
        src={image}
        alt={imageAlt}
        width={500}
        height={400}
        loading="lazy"
        format="webp"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .about-helena-heading {
    font-weight: 400;
    font-size: 40px;
    text-transform: uppercase;
    color: #2b2929;
    margin: 0;
  }
  .about-helena-section {
    display: flex;
    align-items: center;
    gap: 50px;
    height: 100vh;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .about-helena-content-wrapper {
    max-width: 700px;
  }

  .image-wrapper {
    position: relative;
    width: 500px;
    height: 500px;
  }

  .svg-blob {
    position: absolute;
    height: 500px;
    width: 480px;
    top: 0;
    left: 0;
  }

  .about-helena-img {
    position: absolute;
    top: 10%;
    left: 4%;
    z-index: 2;
    height: 400px;
    width: 100%;
    object-fit: contain;
  }
</style>

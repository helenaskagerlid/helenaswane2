---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { paragraphs } from "../utils/paragraphs";

// Redigeras i CMS:et (src/content/pages/transformativcoaching.yml)
const page = await getEntry("coachingPage", "transformativcoaching");
if (!page) throw new Error("src/content/pages/transformativcoaching.yml saknas");
const { heading, text } = page.data;
---

<BaseLayout title="Transformativ Coaching" description="">
  <section class="tc-section">
    <h2>{heading}</h2>
    {paragraphs(text).map((p) => <p>{p}</p>)}
  </section>
</BaseLayout>

<style>
  .tc-section {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100vh;
    padding-inline: 100px;
    padding-block: 50px;
  }

  h2 {
    font-weight: 400;
    font-size: 40px;
    text-transform: uppercase;
    color: #2b2929;
    margin: 0;
  }
</style>
